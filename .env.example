# Copy to `.env` and set the values for YOUR hardware, then `docker compose up -d`.
# Anything left unset falls back to the defaults in config/devices.yaml.

# MQTT broker credentials (must match mosquitto/config/mosquitto.passwd).
MQTT_USER=bssparking
MQTT_PASS=BCTDev_2025

# Your gate boards' serial numbers (the 12-hex "serialNo" they use on MQTT).
GATE1_SERIAL=441D6491AF17
GATE2_SERIAL=441D6491AF18

# Entry / exit LPR units.
LPR_IN_HOST=192.168.1.130
LPR_IN_URL=http://192.168.1.130:8090
LPR_OUT_HOST=192.168.1.149
LPR_OUT_URL=http://192.168.1.149:8090
